      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(sum(rate(o1_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(o1_http_requests_total[5m])), 0.001)) or vector(0)",
