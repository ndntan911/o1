# Production environment for deploy/production/compose.yaml.
#
# Copy this file to .env, replace every placeholder, and keep it out of git
# (.env is ignored). All values are read by Docker Compose; nothing here is a
# real credential.
#
#   cp deploy/production/env.example deploy/production/.env

# --- Required -------------------------------------------------------------

# Public hostname. DNS must point at this host and ports 80/443 must be
# reachable. Caddy obtains and renews the TLS certificate for this name.
O1_DOMAIN=o1.example.com

# PostgreSQL password. Use a URL-safe value: `openssl rand -hex 32`. The
# password is embedded in O1_DATABASE_URL, so characters such as @, :, /, ?,
# and # would need percent-encoding.
POSTGRES_PASSWORD=replace-with-output-of-openssl-rand-hex-32

# Base64 of exactly 32 random bytes: `openssl rand -base64 32`. Used for
# session and key-derivation material.
O1_SECRET_KEY=replace-with-output-of-openssl-rand-base64-32

# Base64 of exactly 32 random bytes: `openssl rand -base64 32`. Required in
# production; encrypts monitor headers and request bodies at rest.
O1_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Sender mailbox. Must be on the domain (or subdomain) verified in Resend.
# A display name is allowed, for example: o1 <noreply@example.com>
O1_EMAIL_FROM=noreply@example.com

# Resend API key with permission to send from the verified domain.
O1_RESEND_API_KEY=re_replace_with_your_resend_api_key

# --- Optional ------------------------------------------------------------

# Reply-To mailbox for transactional and alert email.
# O1_EMAIL_REPLY_TO=support@o1.example.com

# Per-process Resend send rate limit. The default is 2 requests/second with a
# burst of 2; leave both unset unless the Resend plan requires a different rate.
# O1_RESEND_RPS=2
# O1_RESEND_BURST=2

# Promotes this existing, verified account to administrator at startup.
# O1_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- Frontend build-time configuration -----------------------------------

# Empty disables Sentry in the browser bundle. Baked in at build time, so
# rebuild the web image after changing these.
VITE_SENTRY_DSN=
VITE_RELEASE=production

# --- Optional observability ---------------------------------------------

# Empty values disable OTLP tracing, backend Sentry, and the release label.
# O1_OTEL_EXPORTER_OTLP_ENDPOINT=
# O1_OTEL_EXPORTER_OTLP_HEADERS=
# O1_OTEL_SAMPLE_RATIO=0.05
# O1_SENTRY_DSN=
# O1_SENTRY_ENVIRONMENT=production
# O1_RELEASE=production

# Only needed when starting the optional Alloy profile.
# GRAFANA_REMOTE_WRITE_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
# GRAFANA_REMOTE_WRITE_USER=
# GRAFANA_REMOTE_WRITE_TOKEN=

# --- Registry pull credentials (private GHCR packages only) --------------
# The image refs are not set here. They live in the host images.env written by
# the deploy script. Keep private-package credentials out of git.
# GHCR_USER=your-github-user
# GHCR_READ_TOKEN=ghp_token_with_read_packages

# --- Local build (development and testing only) --------------------------
# The base stack pulls digest-pinned registry images. To build api, scheduler,
# worker, and web from a checkout instead, pass the build override:
#
#   docker compose --env-file deploy/production/env.example \
#     -f deploy/production/compose.yaml \
#     -f deploy/production/compose.build.yaml up -d --build
