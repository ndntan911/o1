# Required
O1_DATABASE_URL=postgres://o1:o1@localhost:5432/o1?sslmode=disable
# Base64 of exactly 32 random bytes, e.g. `openssl rand -base64 32`.
O1_SECRET_KEY='<base64 of 32 random bytes>'
# Base64 of exactly 32 random bytes. Required in production; when unset in
# development/test it is derived from O1_SECRET_KEY.
# O1_ENCRYPTION_KEY='<base64 of 32 random bytes>'

# Optional
O1_ENV=development
O1_HTTP_ADDR=:8080
O1_APP_BASE_URL=http://localhost:5173
O1_ALLOWED_ORIGINS=http://localhost:5173
O1_SESSION_COOKIE_NAME=o1_session
O1_SESSION_TTL=720h
O1_SMTP_ADDR=localhost:1025
O1_EMAIL_FROM=o1@localhost
# O1_RESEND_API_KEY=

# Monitoring
O1_MONITOR_MIN_INTERVAL=60s
O1_MONITOR_MAX_INTERVAL=24h
O1_MONITOR_CREATE_LIMIT=10
O1_PROBE_ALLOWED_PORTS=80,443
O1_PROBE_MAX_REDIRECTS=5
O1_PROBE_MAX_BODY_BYTES=1048576
O1_PROBE_GLOBAL_RPS=50
O1_SCHEDULER_TICK=10s
O1_SCHEDULER_BATCH=500
O1_WORKER_CONCURRENCY=50
O1_SCHEDULER_HEALTH_ADDR=:8081
O1_WORKER_HEALTH_ADDR=:8082
# O1_BOOTSTRAP_ADMIN_EMAIL=
