# Required
O1_DATABASE_URL=postgres://o1:o1@localhost:5432/o1?sslmode=disable
# Base64 of exactly 32 random bytes, e.g. `openssl rand -base64 32`.
O1_SECRET_KEY=<base64 of 32 random bytes>

# Optional
O1_ENV=development
O1_HTTP_ADDR=:8080
O1_APP_BASE_URL=http://localhost:5173
O1_ALLOWED_ORIGINS=http://localhost:5173
O1_SESSION_COOKIE_NAME=o1_session
O1_SESSION_TTL=720h
O1_SMTP_ADDR=localhost:1025
O1_EMAIL_FROM=o1@localhost
# O1_RESEND_API_KEY=
