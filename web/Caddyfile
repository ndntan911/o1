{$O1_SITE_ADDRESS::80} {
	root * /srv
	encode gzip zstd

	# Browser baseline for the SPA and every proxied API response. HSTS is
	# ignored on the plain-HTTP development origin and enforced in production,
	# where Caddy terminates TLS. No includeSubDomains or preload: the domain
	# may host other services.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-czNEBGPtlYNZHvYaRai+OZ5jiHUGyBTSIKWPBEGk6sM='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$O1_CSP_EXTRA_CONNECT}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
	}

	# Public health checks are served by the API, not the SPA, so load balancers
	# and the external dead-man's switch see real process/database readiness.
	handle /healthz {
		reverse_proxy api:8080 {
			# Overwrite any client-supplied X-Forwarded-For so the API only sees
			# the address of the immediate proxy peer.
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle /readyz {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Metrics are private. They live on internal listeners that Caddy cannot
	# reach and are never proxied here.
	handle /metrics {
		respond 404
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# MCP is a separate, API-key-authenticated endpoint. It is proxied on the
	# same origin so agent clients use one host, and it must fall through before
	# the SPA so a missing key gets a real 401 instead of index.html.
	handle /mcp {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# The portfolio landing page is a real static file, not the SPA shell.
	@landing path /
	handle @landing {
		rewrite * /landing.html
		file_server
	}
	@landing-file path /landing.html
	redir @landing-file / 301

	# A missing sitemap must 404, never fall through to index.html.
	handle /sitemap.xml {
		header Content-Type application/xml
		file_server
	}

	# Authenticated surfaces must not be indexed even if a crawler finds a link.
	@app path /login /register /verify-email /forgot-password /reset-password /account/* /app /workspaces* /w/* /admin* /billing* /onboarding*
	header @app X-Robots-Tag "noindex"

	handle {
		try_files {path} /index.html
		file_server
	}
}
